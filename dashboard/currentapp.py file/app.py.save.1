def log_alert(alert: Dict[str, Any]):
    try:
        with open(ALERT_LOG, "a", encoding="utf-8") as f:
            f.write(json.dumps(alert) + "\n")
    except Exception as e:
        print("Failed to log alert:", e)

def send_email_alert(smtp_conf: dict, to_email: str, subject: str, body: str) -> bool:
    try:
        msg = EmailMessage()
        msg["From"] = smtp_conf.get("from_addr") or smtp_conf.get("username")
        msg["To"] = to_email
        msg["Subject"] = subject
        msg.set_content(body)

        server = smtplib.SMTP(smtp_conf.get("server", "smtp.gmail.com"), int(smtp_conf.get("port", 587)))
        if smtp_conf.get("starttls", True):
            server.starttls()
        if smtp_conf.get("username") and smtp_conf.get("password"):
            server.login(smtp_conf.get("username"), smtp_conf.get("password"))
        server.send_message(msg)
        server.quit()
        return True
    except Exception as e:
        print("Email send failed:", e)
        return False

def send_telegram_alert(bot_token: str, chat_id: str, text: str) -> bool:
    try:
        url = f"https://api.telegram.org/bot{bot_token}/sendMessage"
        r = requests.post(url, json={"chat_id": chat_id, "text": text})
        return r.status_code == 200
    except Exception as e:
        print("Telegram send failed:", e)
        return False

# ---------------------------
# Risk Scoring
# ---------------------------
def compute_risk(port: int, service_name: str, state: str) -> int:
    base = 10
    if state.lower() == "open":
        base += 20
    if port in (23, 445, 3389, 5900, 2375):
        base += 40
    if port in (80, 443, 8080, 8443):
        base += 15
    s = service_name.lower()
    if "telnet" in s:
        base += 40
    if "ssh" in s:
        base += 10
    if any(k in s for k in ("mysql", "mongodb", "postgres", "redis")):
        base += 25
    return min(100, base)

# ---------------------------
# Manual / probe functions
# ---------------------------
def parse_ports(port_spec: str) -> List[int]:
    port_spec = port_spec.strip()
    if not port_spec:
        return []
    if "-" in port_spec:
        a, b = port_spec.split("-", 1)
        try:
            a_i = int(a); b_i = int(b)
            return list(range(min(a_i, b_i), max(a_i, b_i) + 1))
        except ValueError:
            return []
    else:
        try:
            p = int(port_spec)
            return [p]
        except ValueError:
            return []

def probe_service(host: str, port: int, timeout: float = 2.0) -> Dict[str, Any]:
    info = {"Host": host, "Port": port, "Service": "unknown", "Banner": "", "State": "closed"}
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(timeout)
        res = s.connect_ex((host, port))
        if res == 0:
            info["State"] = "open"
            try:
                if port == 22:  # SSH
                    data = s.recv(256)
                    info["Banner"] = data.decode(errors="ignore").strip()
                    if info["Banner"]:
                        info["Service"] = "ssh"
                elif port in (80, 8080, 8000, 8888):  # HTTP
                    req = b"HEAD / HTTP/1.0\r\nHost: %b\r\n\r\n" % host.encode()
                    s.sendall(req)
                    data = s.recv(1024)
                    info["Banner"] = data.decode(errors="ignore").split("\r\n")[0]
                    info["Service"] = "http"
                elif port in (443, 8443):  # HTTPS
                    info["Service"] = "https"
                    info["Banner"] = "HTTPS (banner not retrieved)"
                elif port == 21:  # FTP
                    data = s.recv(256)
                    info["Banner"] = data.decode(errors="ignore").strip()
                    info["Service"] = "ftp"
                elif port in (25, 587):  # SMTP
                    data = s.recv(256)
                    info["Banner"] = data.decode(errors="ignore").strip()
                    info["Service"] = "smtp"
                elif port in (110, 995, 143):  # POP3/IMAP
                    data = s.recv(256)
                    info["Banner"] = data.decode(errors="ignore").strip()
                elif port == 6379:  # Redis
                    s.sendall(b"INFO\r\n")
                    data = s.recv(1024)
                    info["Banner"] = data.decode(errors="ignore").strip()
                    info["Service"] = "redis"
                else:  # Generic attempt
                    s.sendall(b"\r\n")
                    data = s.recv(256)
                    info["Banner"] = data.decode(errors="ignore").strip()
            except Exception:
                pass
        else:
            info["State"] = "closed"
        s.close()
    except Exception as e:
        info["State"] = "error"
        info["Banner"] = str(e)
    info["Risk"] = compute_risk(port, info.get("Service", ""), info.get("State", ""))
    intel = PORT_INTEL.get(port)
    if intel:
        info["Intel"] = intel[1]
        if info["Service"] == "unknown":
            info["Service"] = intel[0]
    else:
        info["Intel"] = "No quick intel available"
    return info

def manual_scan(host: str, port_spec: str, threads: int = 50) -> List[Dict[str, Any]]:
    ports = parse_ports(port_spec) if port_spec else []
    if not ports:
        return []
    results = []
    q = queue.Queue()
    for p in ports:
        q.put(p)

    def worker():
        while not q.empty():
            try:
                p = q.get_nowait()
            except queue.Empty:
                return
            res = probe_service(host, p)
            results.append(res)
            q.task_done()

    ts = []
    for _ in range(min(threads, max(1, len(ports)))):
        t = threading.Thread(target=worker, daemon=True)
        t.start()
        ts.append(t)
    q.join()
    return sorted(results, key=lambda x: (-x.get("Risk", 0), x.get("Port", 0)))

# ---------------------------
# Active Nmap wrapper
# ---------------------------
def nmap_scan(target: str, ports_spec: str = "", do_all_ports: bool = False) -> List[Dict[str, Any]]:
    if not nmap_available:
        st.error("Nmap is not available. Please install the python-nmap library.")
        return []
    
    scanner = nmap.PortScanner()
    args = "-sV -O -Pn"  # service/version + OS + skip host discovery
    if do_all_ports:
        args += " -p 0-65535"
    elif ports_spec:
        args += f" -p {ports_spec}"
    
    try:
        scanner.scan(hosts=target, arguments=args)
    except Exception as e:
        st.error(f"Failed to run nmap scan: {e}")
        return []

    rows = []
    for h in scanner.all_hosts():
        host_info = scanner[h]
        hostnames = host_info.get('hostnames', [])
        hostname = hostnames[0].get('name', '') if hostnames else ''
        state = host_info.get('status', {}).get('state', '')
        osmatch = host_info.get('osmatch', [{}])[0].get('name', '')

        for proto in host_info.all_protocols():
            ports = host_info.get(proto, {})
            for port, pdata in ports.items():
                row = {
                    "Host": h,
                    "Hostname": hostname,
                    "State": state,
                    "Port": int(port),
                    "Protocol": proto,
                    "Service": pdata.get("name", ""),
                    "Product": pdata.get("product", ""),
                    "Version": pdata.get("version", ""),
                    "OS_Guess": osmatch,
                    "Risk": compute_risk(int(port), pdata.get("name", ""), state)
                }
                intel = PORT_INTEL.get(int(port))
                row["Intel"] = intel[1] if intel else "No quick intel"
                rows.append(row)
    return rows

