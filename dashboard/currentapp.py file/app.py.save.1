def raise_alert(level: str, short: str, details: dict):
    t = time.strftime("%Y-%m-%d %H:%M:%S")
    alert = {"time": t, "level": level, "summary": short, "details": details}
    st.session_state.alerts.insert(0, alert)
    log_alert(alert)
    body = f"AI-IDS Alert\nTime: {t}\nLevel: {level}\nSummary: {short}\nDetails:\n{json.dumps(details, indent=2)}"
    
    # Email alert
    if smtp_enable and alert_email_to and smtp_user and smtp_pass:
        smtp_conf = {
            "server": smtp_server,
            "port": smtp_port,
            "username": smtp_user,
            "password": smtp_pass,
            "from_addr": from_addr or smtp_user
        }
        ok = send_email_alert(smtp_conf, alert_email_to, f"AI-IDS Alert: {short}", body)
        alert["email_sent"] = ok
    
    # Telegram alert
    if tel_enable and tel_bot_token and tel_chat_id:
        ok2 = send_telegram_alert(tel_bot_token, tel_chat_id, body)
        alert["telegram_sent"] = ok2

